      "codigo": {
        "html": "<article class=\"kcx-animated-border\">\n  <h2 class=\"kcx-animated-border__titulo\">Plano Pro</h2>\n  <p class=\"kcx-animated-border__texto\">O card em destaque.</p>\n</article>",
        "css": "/* Animated Border — controlado pelas variáveis KCX */\n/* Registrar o ângulo permite animá-lo (sem isso o gradiente pularia). */\n@property --kcx-animated-border-giro {\n  syntax: '<angle>';\n  initial-value: 0deg;\n  inherits: false;\n}\n\n.kcx-animated-border {\n  display: grid;\n  gap: var(--kcx-animated-border-gap);\n  width: min(100%, var(--kcx-animated-border-width));\n  padding: var(--kcx-animated-border-padding);\n  border: var(--kcx-animated-border-border) solid transparent;\n  border-radius: var(--kcx-animated-border-radius);\n  background:\n    linear-gradient(var(--kcx-animated-border-card), var(--kcx-animated-border-card)) padding-box,\n    conic-gradient(\n      from calc(var(--kcx-animated-border-start) + var(--kcx-animated-border-giro)),\n      var(--kcx-animated-border-c1), var(--kcx-animated-border-c2), var(--kcx-animated-border-c1)\n    ) border-box;\n  animation: var(--kcx-animated-border-animation) calc(var(--kcx-animated-border-duration) / var(--kcx-animated-border-speed)) linear infinite var(--kcx-animated-border-direction);\n}\n\n.kcx-animated-border__titulo { margin: 0; color: var(--kcx-animated-border-text); font: 700 1.25rem/1.2 Inter, system-ui, sans-serif; }\n.kcx-animated-border__texto { margin: 0; color: var(--kcx-animated-border-muted); font: 400 0.95rem/1.5 Inter, system-ui, sans-serif; }\n\n@keyframes kcx-animated-border-girar {\n  to { --kcx-animated-border-giro: 360deg; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .kcx-animated-border { animation: none; }\n}",
        "js": "// Sem JavaScript: o giro é uma custom property registrada com @property."
