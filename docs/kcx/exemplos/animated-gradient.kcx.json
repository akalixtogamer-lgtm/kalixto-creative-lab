      "codigo": {
        "html": "<section class=\"kcx-animated-gradient\">\n  <h1 class=\"kcx-animated-gradient__titulo\">Gradiente animado</h1>\n</section>",
        "css": "/* Animated Gradient — controlado pelas variáveis KCX */\n.kcx-animated-gradient {\n  display: grid;\n  place-items: center;\n  width: min(100%, var(--kcx-animated-gradient-width));\n  height: min(var(--kcx-animated-gradient-height), 56.25vw);\n  border-radius: var(--kcx-animated-gradient-radius);\n  background-image: var(--kcx-animated-gradient-image);\n  background-size: var(--kcx-animated-gradient-size) var(--kcx-animated-gradient-size);\n  background-position: var(--kcx-animated-gradient-from) 50%;\n  animation: kcx-animated-gradient-deslizar calc(var(--kcx-animated-gradient-duration) / var(--kcx-animated-gradient-speed)) var(--kcx-animated-gradient-easing) var(--kcx-animated-gradient-delay)\n    var(--kcx-animated-gradient-iterations) var(--kcx-animated-gradient-direction) both;\n  animation-play-state: var(--kcx-animated-gradient-play);\n}\n\n.kcx-animated-gradient__titulo {\n  margin: 0;\n  padding: 0 24px;\n  color: var(--kcx-animated-gradient-text);\n  font: 700 var(--kcx-animated-gradient-title-size) / 1.1 Inter, system-ui, sans-serif;\n  text-align: center;\n  text-shadow: 0 2px 12px rgb(0 0 0 / 0.45);\n}\n\n.kcx-animated-gradient__titulo:empty { display: none; }\n\n@keyframes kcx-animated-gradient-deslizar {\n  from { background-position: var(--kcx-animated-gradient-from) 50%; }\n  to   { background-position: var(--kcx-animated-gradient-to) 50%; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .kcx-animated-gradient { animation: none; }\n}",
        "js": "// Não precisa de JavaScript. Controle em tempo real: KCX.set('duration', 4)"
