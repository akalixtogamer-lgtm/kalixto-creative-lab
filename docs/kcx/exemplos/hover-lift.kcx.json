      "codigo": {
        "html": "<button class=\"kcx-hover-lift\" type=\"button\"><span class=\"kcx-hover-lift__rotulo\">Quero participar</span></button>",
        "css": "/* Hover Lift Button — controlado pelas variáveis KCX */\n.kcx-hover-lift {\n  padding: var(--kcx-hover-lift-py) var(--kcx-hover-lift-px);\n  border: 0;\n  border-radius: var(--kcx-hover-lift-radius);\n  background: linear-gradient(135deg, var(--kcx-hover-lift-c1), var(--kcx-hover-lift-c2));\n  color: var(--kcx-hover-lift-text);\n  font: 600 var(--kcx-hover-lift-font) / 1.2 Inter, system-ui, sans-serif;\n  cursor: pointer;\n  transition:\n    transform var(--kcx-hover-lift-duration) ease,\n    box-shadow var(--kcx-hover-lift-duration) ease;\n}\n\n.kcx-hover-lift:hover,\n.kcx-hover-lift:focus-visible {\n  transform: translateY(calc(var(--kcx-hover-lift-lift) * -1)) scale(var(--kcx-hover-lift-scale));\n  box-shadow: 0 calc(var(--kcx-hover-lift-blur) / 3) var(--kcx-hover-lift-blur)\n    color-mix(in srgb, var(--kcx-hover-lift-shadow) var(--kcx-hover-lift-shadow-alpha), transparent);\n}\n\n.kcx-hover-lift:focus-visible { outline: 2px solid var(--kcx-hover-lift-shadow); outline-offset: 4px; }\n.kcx-hover-lift:active { transform: translateY(0) scale(0.98); }\n\n@media (prefers-reduced-motion: reduce) {\n  .kcx-hover-lift:hover,\n  .kcx-hover-lift:focus-visible { transform: none; }\n}",
        "js": "// Sem JavaScript: hover e foco são só CSS."
