      "codigo": {
        "html": "<div class=\"kcx-svg-motion\" role=\"img\" aria-label=\"Linha que se desenha com um ponto percorrendo o caminho\">\n  <svg viewBox=\"0 0 400 160\" width=\"400\" height=\"160\" aria-hidden=\"true\">\n    <path class=\"kcx-svg-motion__trilha\" d=\"M 10 80 C 60 10 110 10 160 80 S 260 150 310 80 S 380 20 390 40\" pathLength=\"1\" />\n    <path class=\"kcx-svg-motion__linha\" d=\"M 10 80 C 60 10 110 10 160 80 S 260 150 310 80 S 380 20 390 40\" pathLength=\"1\" />\n  </svg>\n  <span class=\"kcx-svg-motion__ponto\"></span>\n</div>",
        "css": "/* SVG Motion — controlado pelas variáveis KCX */\n.kcx-svg-motion {\n  position: relative;\n  width: 400px;\n  height: 160px;\n  max-width: 100%;\n}\n\n.kcx-svg-motion svg { position: absolute; inset: 0; overflow: visible; }\n\n.kcx-svg-motion path {\n  fill: none;\n  stroke: var(--kcx-svg-motion-stroke);\n  stroke-width: var(--kcx-svg-motion-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.kcx-svg-motion__trilha { opacity: var(--kcx-svg-motion-trail); }\n\n.kcx-svg-motion__linha {\n  stroke-dasharray: 1;\n  stroke-dashoffset: var(--kcx-svg-motion-offset);\n  animation: var(--kcx-svg-motion-anim-linha) calc(var(--kcx-svg-motion-duration) / var(--kcx-svg-motion-speed)) var(--kcx-svg-motion-easing) var(--kcx-svg-motion-delay)\n    var(--kcx-svg-motion-iterations) var(--kcx-svg-motion-direction) both;\n}\n\n.kcx-svg-motion__ponto {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: var(--kcx-svg-motion-dot);\n  height: var(--kcx-svg-motion-dot);\n  border-radius: 50%;\n  background: var(--kcx-svg-motion-accent);\n  box-shadow: 0 0 var(--kcx-svg-motion-dot) var(--kcx-svg-motion-accent);\n  offset-path: var(--kcx-svg-motion-path);\n  offset-distance: var(--kcx-svg-motion-distance);\n  offset-rotate: 0deg;\n  animation: var(--kcx-svg-motion-anim-ponto) calc(var(--kcx-svg-motion-duration) / var(--kcx-svg-motion-speed)) var(--kcx-svg-motion-easing) var(--kcx-svg-motion-delay)\n    var(--kcx-svg-motion-iterations) var(--kcx-svg-motion-direction) both;\n}\n\n@keyframes kcx-svg-motion-desenhar {\n  from { stroke-dashoffset: 1; }\n  to   { stroke-dashoffset: 0; }\n}\n\n@keyframes kcx-svg-motion-percorrer {\n  from { offset-distance: 0%; }\n  to   { offset-distance: 100%; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .kcx-svg-motion__linha,\n  .kcx-svg-motion__ponto { animation: none; }\n}",
        "js": "// Não precisa de JavaScript. A forma troca o atributo d dos paths (feito pelo runtime KCX):\n// KCX.set('shape', 'laco')",
        "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400\" height=\"160\" viewBox=\"0 0 400 160\"><path d=\"M 10 80 C 60 10 110 10 160 80 S 260 150 310 80 S 380 20 390 40\" fill=\"none\" stroke=\"#22e3ff\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
      },
