      "codigo": {
        "html": "<div class=\"kcx-neon-glow\">\n  <span class=\"kcx-neon-glow__halo\" aria-hidden=\"true\"></span>\n  <button class=\"kcx-neon-glow__botao\" type=\"button\"><span class=\"kcx-neon-glow__rotulo\">Ao vivo</span></button>\n</div>",
        "css": "/* Neon Glow — todas as propriedades vêm das variáveis KCX (bloco :root acima) */\n.kcx-neon-glow {\n  position: relative;\n  display: inline-grid;\n  place-items: center;\n  opacity: var(--kcx-neon-glow-opacity);\n}\n\n.kcx-neon-glow__halo {\n  position: absolute;\n  inset: calc(var(--kcx-neon-glow-distance) * -0.5);\n  border-radius: calc(var(--kcx-neon-glow-radius) + var(--kcx-neon-glow-distance) * 0.5);\n  background: linear-gradient(90deg, var(--kcx-neon-glow-primary), var(--kcx-neon-glow-secondary));\n  filter: blur(var(--kcx-neon-glow-blur)) brightness(var(--kcx-neon-glow-filter));\n  opacity: calc(var(--kcx-neon-glow-layer-alpha) * var(--kcx-neon-glow-enabled));\n  animation: var(--kcx-neon-glow-animation) calc(var(--kcx-neon-glow-duration) / var(--kcx-neon-glow-speed)) ease-in-out infinite alternate;\n  transition: scale var(--kcx-neon-glow-transition) ease, opacity var(--kcx-neon-glow-transition) ease;\n  pointer-events: none;\n}\n\n@keyframes kcx-neon-glow-pulsar {\n  from { transform: scale(0.94); opacity: calc(var(--kcx-neon-glow-layer-alpha) * 0.55 * var(--kcx-neon-glow-enabled)); }\n  to   { transform: scale(1.04); opacity: calc(var(--kcx-neon-glow-layer-alpha) * var(--kcx-neon-glow-enabled)); }\n}\n\n.kcx-neon-glow__botao {\n  position: relative;\n  padding: var(--kcx-neon-glow-py) var(--kcx-neon-glow-px);\n  border: var(--kcx-neon-glow-border) solid var(--kcx-neon-glow-primary);\n  border-radius: var(--kcx-neon-glow-radius);\n  background: var(--kcx-neon-glow-bg);\n  color: var(--kcx-neon-glow-text);\n  font: 600 1rem/1 Inter, system-ui, sans-serif;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  cursor: pointer;\n  box-shadow:\n    0 0 var(--kcx-neon-glow-reach) var(--kcx-neon-glow-primary),\n    inset 0 0 calc(var(--kcx-neon-glow-reach) * 0.5) rgb(255 255 255 / var(--kcx-neon-glow-inner));\n  transition: box-shadow var(--kcx-neon-glow-transition) ease, transform var(--kcx-neon-glow-transition) ease;\n}\n\n/* Estados */\n.kcx-neon-glow:hover .kcx-neon-glow__halo,\n.kcx-neon-glow:focus-within .kcx-neon-glow__halo { scale: var(--kcx-neon-glow-hover); }\n\n.kcx-neon-glow__botao:hover,\n.kcx-neon-glow__botao:focus-visible {\n  box-shadow:\n    0 0 calc(var(--kcx-neon-glow-reach) * var(--kcx-neon-glow-hover)) var(--kcx-neon-glow-primary),\n    inset 0 0 var(--kcx-neon-glow-reach) rgb(255 255 255 / var(--kcx-neon-glow-inner));\n}\n\n.kcx-neon-glow__botao:active { transform: scale(0.97); }\n.kcx-neon-glow__botao:focus-visible { outline: 2px solid var(--kcx-neon-glow-secondary); outline-offset: 6px; }\n\n@media (prefers-reduced-motion: reduce) {\n  .kcx-neon-glow__halo { animation: none; }\n}",
        "js": "// Neon Glow não precisa de JavaScript. Para controlar em tempo real, use o runtime KCX:\n// KCX.set('glowIntensity', 1.6)"
      },
