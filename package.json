{
  "name": "kalixto-creative-lab",
  "version": "1.22.0-rc.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "npm run figma:build && ng build --base-href /kalixto-creative-lab/ && node scripts/copiar-404.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "docs:efeitos": "esbuild scripts/exportar-efeitos.ts --bundle --platform=node --format=esm --log-level=error --outfile=.angular/exportar-efeitos.mjs && node .angular/exportar-efeitos.mjs | python3 scripts/gerar-docs-efeitos.py",
    "gerar:angular": "esbuild scripts/gerar-angular.ts --bundle --platform=node --format=esm --log-level=error --outfile=.angular/gerar-angular.mjs && node .angular/gerar-angular.mjs && prettier --write src/app/efeitos-angular --log-level=warn",
    "verificar:angular": "npm run gerar:angular && git diff --exit-code -- src/app/efeitos-angular",
    "figma:build": "node scripts/build-figma.mjs",
    "figma:check": "tsc -p figma-bridge/tsconfig.json",
    "kcx:schema": "esbuild scripts/exportar-schema-kcx.ts --bundle --platform=node --format=esm --log-level=error --outfile=.angular/kcx-schema.mjs && node .angular/kcx-schema.mjs",
    "gerar:kcx-angular": "esbuild scripts/gerar-kcx-angular.ts --bundle --platform=node --format=esm --log-level=error --outfile=.angular/gerar-kcx-angular.mjs && node .angular/gerar-kcx-angular.mjs && prettier --write src/app/kcx-angular --log-level=warn",
    "verificar:kcx-angular": "npm run gerar:kcx-angular && git diff --exit-code -- src/app/kcx-angular",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "npm run format:check && npm run lint && npm run figma:check && npm run verificar:angular && npm run verificar:kcx-angular && npm test && npm run build",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "pdf-lib": "^1.17.1",
    "rxjs": "~7.8.0",
    "three": "^0.187.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.142.0",
    "@types/three": "^0.187.0",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  },
  "description": "KALIXTO CREATIVE LAB — laboratório de aprendizagem e experimentação de Creative Development.",
  "lint-staged": {
    "*.{ts,html,css,json,md,mjs,js}": "prettier --write",
    "*.{ts,html}": "eslint --fix"
  }
}
